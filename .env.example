ALLOWED_ORIGIN=
SUPABASE_ANON_KEY=
SUPABASE_URL=
VITE_APP_VERSION=
# Leave EMPTY in local dev: requests go same-origin and the vite proxy
# routes /api/auth-admin -> BFF(:10000) and /api/export -> export-api(:10001),
# so no CORS is involved at all. Only set it for a cross-origin deploy,
# and then it must point at the BFF (export calls need host rewrites).
VITE_BFF_URL=
# Optional overrides for the auto-update flow (defaults: 150000 / 5000).
VITE_UPDATE_POLL_MS=
VITE_UPDATE_COUNTDOWN_MS=
# Optional observability: POST JSON vitals/errors here. Unset = console-only.
# See docs/ops/monitoring.md.
VITE_RUM_ENDPOINT=
VITE_ERROR_ENDPOINT=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
# NOTE: VITE_SUPABASE_SERVICE_ROLE_KEY must NEVER be set here — check-env rejects it; it lives on the BFF service only.