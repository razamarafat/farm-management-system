# Node / build artefacts
/node_modules
/dist
.vite

# ---------------------------------------------------------------
# Environment variables ΓÇö anything that can contain secrets.
# Matches all known variants (dot, dash, uppercase for tooling).
# ---------------------------------------------------------------
.env
.env.*
!.env.example
!.bff/.env.example
.envrc

# ---------------------------------------------------------------
# Repo hygiene: artefacts that have leaked secrets before.
# ---------------------------------------------------------------
# repo XML dumps (repomix) ΓÇö these have historically mirrored .env.
repomix-output.xml
allcode.txt

# Migration/apply scripts + audit backups ΓÇö contain live Supabase
# access tokens (sbp_...) used to run migrations. Local-only.
apply_reporting.sh
/backups/

# Windows CMD artefacts (the result of `> nul` redirections).
nul
tmp.js

# BFF local env (used by `cd bff && npm start`)
