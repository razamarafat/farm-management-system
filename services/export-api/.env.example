# =====================================================================
# services/export-api/.env.example
#
# Required (read at startup; service crashes if missing).
# =====================================================================
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...   # anon key, safe to ship — never the service-role key

# Optional. When present, used only by future admin-bound flows
# (export audit log, etc.) — NOT used by regular query paths. Leave
# empty in dev; set in production only if you wire those flows.
# SUPABASE_SECRET_KEY=

# CORS allowlist (comma-sep). Must include every origin that hosts the
# SPA. The dev SPA runs on http://localhost:3000 (vite default port —
# keep this in sync with vite.config.ts). Lock this down to your real
# production domain(s) when NODE_ENV=production; if left empty in prod
# the server refuses ALL cross-origin requests (fail-closed).
ALLOWED_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Server port (Render sets this automatically via PORT env var).
# Must match the /api/export proxy target in vite.config.ts (10001); the dev
# SPA itself runs on port 3000, so keep these distinct.
PORT=10001

# Node env. Render sets NODE_ENV=production on deploy.
NODE_ENV=development
